# ============ Line Collection — configuração ============
# Copie este arquivo para ".env" (o start.bat faz isso sozinho) e preencha.
# NUNCA envie o arquivo .env para ninguém nem para o GitHub.

NODE_ENV=development
PORT=3000
# Endereço público do site. Local: http://localhost:3000 | Hospedagem: https://seudominio.com.br
BASE_URL=http://localhost:3000

# Chave para assinar sessões. Obrigatória em produção (mínimo 32 caracteres aleatórios).
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Onde ficam o banco e os arquivos privados dos plugins (em hospedagem, aponte para um disco persistente)
DATABASE_PATH=./data/linecollection.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=200

# ---- Pagamento ----
# sandbox = simulação local, SEM dinheiro real (só para testar)
# mercadopago = pagamento real
PAYMENT_PROVIDER=sandbox
# Só para PAYMENT_PROVIDER=mercadopago (painel do Mercado Pago > Suas integrações):
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---- Email (opcional; usado só para "esqueci minha senha") ----
# Sem SMTP o link de redefinição aparece no terminal (útil em testes locais).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Line Collection <contato@seudominio.com.br>"
